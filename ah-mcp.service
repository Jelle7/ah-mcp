[Unit]
Description=Albert Heijn MCP Server
After=network.target

[Service]
User=ah-mcp
EnvironmentFile=/home/ah-mcp/.env
ExecStart=/usr/local/bin/ah-mcp --transport streamable-http
WorkingDirectory=/home/ah-mcp
Restart=on-failure
RestartSec=5

# The process holds a live Albert Heijn session, so give it as little of the
# host as it can run with.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ah-mcp/.config
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
